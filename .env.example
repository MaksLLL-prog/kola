# Скопируйте в .env и заполните
DOMAIN=kolo.example.com            # домен, A-запись которого указывает на ваш сервер
POSTGRES_PASSWORD=придумайте-длинный-пароль
JWT_SECRET=                         # openssl rand -hex 48

# Картинки в S3-совместимом хранилище (необязательно; без этого лежат в томе uploads)
S3_BUCKET=
S3_ENDPOINT=                        # для не-AWS: https://<account>.r2.cloudflarestorage.com, https://s3.selcdn.ru и т.п.
S3_REGION=auto
S3_PUBLIC_URL=                      # публичный адрес бакета, например https://img.kolo.example.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
